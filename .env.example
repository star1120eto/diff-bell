# ============================================================
# DiffBell 環境変数
# このファイルをコピーして .env を作成してください。
# .env は絶対に git commit しないこと。
# ============================================================

# --- Supabase (ローカル開発用デフォルト値) ---
# キーは `supabase status --output json | jq -r '.ANON_KEY'` で取得 (JWT 形式を使用)
# ※ `supabase status` の Publishable/Secret 表示は supabase-js 非対応
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key-here

# --- Supabase (Edge Function / CI 用: server-side only) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here
SUPABASE_DB_PASSWORD=postgres

# --- Supabase CLI (本番 deploy 時) ---
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_REF=your-project-ref

# --- Resend (メール通知) ---
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@diffbell.app

# --- Cron セキュリティ ---
# Supabase Cron → Edge Function 認証用シークレット
CRON_SECRET=change-me-to-a-random-secret

# --- Cloudflare Pages (deploy 時) ---
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# --- アプリ設定 ---
VITE_APP_URL=http://localhost:5173
